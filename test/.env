# Copy to .env in the same directory as app.py.
# Supply your EXISTING database password and Meditron API key locally.
DATABASE_URL=postgresql://postgres:zaima@localhost:5432/imci_ai_prod
DB_SCHEMA=ml_analytics_v5
DB_TABLE=location_disease_forecasts
RECOMMENDATION_TABLE=location_disease_recommendations
GUIDANCE_CACHE_TABLE=imci_guidance_cache

MEDITRON_URL=https://meditron-api.scibd.info/v1/chat/completions
MEDITRON_MODEL=meditron-27b
MEDITRON_API_KEY=Qct69YgnLdi6EOKpYTAdInZgBb3-4vtk6xTRVzhv8JQ
MEDITRON_AUTH_SCHEME=Bearer
MEDITRON_VERIFY_SSL=false
# MEDITRON_CA_BUNDLE=C:/certs/company-ca.pem

IMCI_PDF_PATH=C:/PROJECTS/IMCI/forecast_recommendation/IMCI_CHART_BOOKLET.pdf
FORECAST_COUNT_COLUMN=predicted_total_assessments
LOCATION_TYPE_COLUMN=hierarchy_level
LOCATION_KEY_COLUMN=location_key
DIVISION_COLUMN=division_name
DISTRICT_COLUMN=district_name
UPAZILA_COLUMN=upazila_name
UNION_COLUMN=union_name
DISEASE_CODE_COLUMN=disease_code
DISEASE_NAME_COLUMN=disease_name
FORECAST_DATE_COLUMN=forecast_date
RISK_COLUMN=predicted_severity_label
TREND_COLUMN=risk_trend_label
MAX_SOURCE_ROWS=10000

RETRIEVAL_TOP_K=1
MAX_CONTEXT_CHARS=600
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.embedding_cache

# /generate retrieves IMCI passages and calls Meditron.
MEDITRON_TIMEOUT=300
MEDITRON_MAX_TOKENS=750
MEDITRON_MAX_RETRIES=1
MEDITRON_MIN_INTERVAL_SECONDS=60
MEDITRON_MAX_RETRY_WAIT=90
REQUEST_BUDGET_SECONDS=720

# Generate a strong independent random token; do not reuse the Meditron API key.
ADMIN_PREPARE_TOKEN=4Z-dPK3-aipyGePS5d7aB_29paccxB777Gtm5WDJZgY
LOG_LEVEL=INFO
