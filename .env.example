# PostgreSQL connection: database must be ml_analytics_v5 (or your configured DB)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ml_analytics_v5
DB_SCHEMA=gold
DB_TABLE=location_disease_forecasts
RECOMMENDATION_TABLE=location_disease_recommendations

# Meditron OpenAI-compatible chat completions endpoint
MEDITRON_URL=https://meditron-api.scibd.info/v1/chat/completions
MEDITRON_MODEL=meditron-27b
MEDITRON_API_KEY=YOUR_MEDITRON_API_KEY
MEDITRON_CONNECT_TIMEOUT=10
MEDITRON_TIMEOUT=180
MEDITRON_MAX_TOKENS=400
MEDITRON_MAX_RETRIES=3
MEDITRON_RETRY_BASE_DELAY=1
MEDITRON_RETRY_MAX_DELAY=20
MEDITRON_RETRY_JITTER=0.25
MEDITRON_AUTH_SCHEME=Bearer
# Set to false to bypass SSL verification when behind a corporate proxy or self-signed cert
MEDITRON_VERIFY_SSL=false

# PDF path on the computer/server running this API
IMCI_PDF_PATH=C:/PROJECTS/IMCI/forecast_recommendation/IMCI_CHART_BOOKLET.pdf

# RAG Knowledge Base configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MAX_PASSAGE_CHARS=450
INDEX_CACHE_PATH=.cache/imci_rag_index.pkl

# Source table column mappings
LOCATION_TYPE_COLUMN=hierarchy_level
LOCATION_KEY_COLUMN=location_key
DIVISION_COLUMN=division_name
DISTRICT_COLUMN=district_name
UPAZILA_COLUMN=upazila_name
UNION_COLUMN=union_name
DISEASE_CODE_COLUMN=disease_code
DISEASE_NAME_COLUMN=disease_name
FORECAST_DATE_COLUMN=forecast_date
RISK_COLUMN=predicted_severity_label
TREND_COLUMN=risk_trend_label

# Optional: only fetch up to this many rows per generation request
MAX_SOURCE_ROWS=10000
FORECAST_COUNT_COLUMN=predicted_total_assessments
